{
  "name": "m3u-player",
  "version": "1.0.0",
  "private": true,
  "description": "Installable web app (PWA) for playing and organising M3U / M3U8 IPTV playlists on iPhone.",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "vendor": "cp node_modules/hls.js/dist/hls.min.js vendor/hls.min.js",
    "build:web": "node scripts/build-web.js",
    "ios:sync": "npm run build:web && npx cap sync ios"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "hls.js": "1.6.15"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2"
  }
}
