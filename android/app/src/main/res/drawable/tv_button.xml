<?xml version="1.0" encoding="utf-8"?>
<!-- Player dialog buttons: the same pills as the player's own (solid white when focused, outlined dark otherwise). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><inset android:insetTop="4dp" android:insetBottom="4dp" android:insetLeft="4dp" android:insetRight="4dp"><shape><solid android:color="#FFFFFFFF"/><corners android:radius="22dp"/></shape></inset></item>
    <item><inset android:insetTop="4dp" android:insetBottom="4dp" android:insetLeft="4dp" android:insetRight="4dp"><shape><solid android:color="#8C0E1014"/><stroke android:width="2dp" android:color="#8CFFFFFF"/><corners android:radius="22dp"/></shape></inset></item>
</selector>
